{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restic-central.invalid/schemas/v1/_shared.schema.json",
  "$defs": {
    "hook": {
      "type": "object",
      "description": "Commande allowlistée; aucun shell implicite; références secrètes seulement.",
      "required": ["executable", "args", "timeout_seconds", "condition"],
      "properties": {"executable": {"type": "string", "pattern": "^/"}, "args": {"type": "array", "items": {"type": "string", "maxLength": 4096}, "minItems": 0, "maxItems": 256}, "working_directory": {"type": "string"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "condition": {"type": "string", "enum": ["always", "on_success", "on_failure"]}},
      "additionalProperties": false
    }
  }
}
