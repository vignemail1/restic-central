{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restic-central.invalid/schema/bootstrap-v1.json",
  "title": "restic-central bootstrap envelope",
  "type": "object",
  "required": ["schema_version", "message_type", "message_id", "payload"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "message_type": {"type": "string", "enum": ["agent.enroll", "job.accept", "job.result", "config.apply"]},
    "message_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "agent_id": {"type": "string", "format": "uuid"},
    "server_job_id": {"type": "string", "format": "uuid"},
    "local_job_uuid": {"type": "string", "format": "uuid"},
    "sent_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
